[Unit]
Description=Ontvangst en opslag van practicum-metingen
After=network-online.target
Wants=network-online.target

[Service]
User=iot
Group=iot
WorkingDirectory=/opt/iot/programmatuur
ExecStart=/opt/iot/venv/bin/python /opt/iot/programmatuur/ontvangen.py --instellingen /etc/iot/ontvangst.geheim.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/iot
UMask=0077

[Install]
WantedBy=multi-user.target
