[Unit]
Description=Beveiligde bereikbaarheidstest voor het IoT-practicum
After=network.target

[Service]
User=iot
Group=iot
WorkingDirectory=/opt/iot/programmatuur
ExecStart=/opt/iot/venv/bin/uvicorn statusdienst:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
